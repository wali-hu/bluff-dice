/**
 * Copies the BluffDice and BluffChips ABIs from the root Hardhat artifacts, plus the KMSVerifier errors our
 * calls can hit, into src/contracts/abi.ts (`as const`, so viem infers every type).
 *
 * Run from web/ after `npm run compile` at the root:  npm run sync-abi
 */
import { execFileSync } from "node:child_process";
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

import { ARTIFACTS, KMS_VERIFIER_ARTIFACT, KMS_VERIFIER_ERRORS, KMS_VERIFIER_V040_ERRORS } from "./abiSources.mts";

const webDir = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const outFile = resolve(webDir, "src/contracts/abi.ts");

function readAbi(path: string): unknown[] {
  return JSON.parse(readFileSync(resolve(webDir, path), "utf8")).abi as unknown[];
}

const kmsAbi = readAbi(KMS_VERIFIER_ARTIFACT) as { type: string; name?: string }[];
const kmsErrors = KMS_VERIFIER_ERRORS.map((name) => {
  const item = kmsAbi.find((entry) => entry.type === "error" && entry.name === name);
  if (!item) throw new Error(`KMSVerifier artifact has no error ${name}`);
  return item;
});

const sections = [
  "// GENERATED by scripts/sync-abi.mts from the root Hardhat artifacts. Do not edit by hand.",
  "",
  ...Object.entries(ARTIFACTS).map(
    ([name, path]) => `export const ${name} = ${JSON.stringify(readAbi(path))} as const;\n`,
  ),
  "/** KMSVerifier errors reachable through FHE.checkSignatures (v0.1.0 artifact + Sepolia v0.4.0 additions). */",
  `export const kmsVerifierErrorsAbi = ${JSON.stringify([...kmsErrors, ...KMS_VERIFIER_V040_ERRORS])} as const;`,
  "",
];

writeFileSync(outFile, sections.join("\n"));
// One code style for the whole repo: format with the root Prettier config.
execFileSync("npx", ["prettier", "--write", outFile], { cwd: resolve(webDir, ".."), stdio: "inherit" });
console.log(`Wrote ${outFile}`);
