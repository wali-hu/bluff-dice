# Copy to .env.local (gitignored). All values are public: they are shipped to the browser.
# Keyless (or domain-restricted) Sepolia JSON-RPC endpoint used for reads.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
# Address of the bot player (Phase F). Empty = bot mode hidden.
NEXT_PUBLIC_BOT_ADDRESS=
# First block to scan for the bot's tables (Phase F). Empty = the BluffDice deploy block.
NEXT_PUBLIC_BOT_FROM_BLOCK=
